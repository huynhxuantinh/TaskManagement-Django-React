DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=tasks.example.internal
POSTGRES_DB=task_management
POSTGRES_USER=task_management
POSTGRES_PASSWORD=replace-with-a-strong-database-password
CSRF_TRUSTED_ORIGINS=https://tasks.example.internal
CORS_ALLOWED_ORIGINS=
HTTPS_BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443
TLS_CERT_DIR=C:/secure/task-management/tls
BACKUP_DIR=C:/secure/task-management/backups
TARGET_DATABASE=task_management_restore_drill
ALLOW_RESTORE=NO
LOG_LEVEL=INFO
