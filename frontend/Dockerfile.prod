FROM node:24.14.1-alpine3.23 AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build


FROM nginx:1.28.0-alpine3.21

COPY infra/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=build --chown=nginx:nginx /app/dist /usr/share/nginx/html

RUN mkdir -p /srv/static /srv/media /tmp/nginx/client_temp \
    /tmp/nginx/proxy_temp /tmp/nginx/fastcgi_temp /tmp/nginx/uwsgi_temp \
    /tmp/nginx/scgi_temp \
    && chown -R nginx:nginx /srv /tmp/nginx /usr/share/nginx/html

USER nginx

EXPOSE 8443

CMD ["nginx", "-g", "daemon off;"]
