FROM node:24.14.1-alpine3.23@sha256:8510330d3eb72c804231a834b1a8ebb55cb3796c3e4431297a24d246b8add4d5 AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
ARG VITE_API_BASE_URL=
ARG VITE_ALLOW_PUBLIC_REGISTRATION=false
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_ALLOW_PUBLIC_REGISTRATION=$VITE_ALLOW_PUBLIC_REGISTRATION
RUN npm run build


FROM nginx:1.28.0-alpine3.21@sha256:30f1c0d78e0ad60901648be663a710bdadf19e4c10ac6782c235200619158284

COPY infra/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=build --chown=nginx:nginx /app/dist /usr/share/nginx/html

RUN mkdir -p /srv/static /srv/media /tmp/client_temp /tmp/proxy_temp \
    /tmp/fastcgi_temp /tmp/uwsgi_temp /tmp/scgi_temp \
    && chown -R nginx:nginx /srv /tmp/client_temp /tmp/proxy_temp \
    /tmp/fastcgi_temp /tmp/uwsgi_temp /tmp/scgi_temp /usr/share/nginx/html

USER nginx

EXPOSE 8443

CMD ["nginx", "-g", "daemon off;"]
